{
  "name": "real-capita-accounts",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@11.1.2",
  "scripts": {
    "dev": "pnpm --parallel --filter @real-capita-accounts/web --filter @real-capita-accounts/api dev",
    "dev:web": "pnpm --filter @real-capita-accounts/web dev",
    "dev:api": "pnpm --filter @real-capita-accounts/api dev",
    "build": "pnpm -r build",
    "build:web": "pnpm --filter @real-capita-accounts/web build",
    "build:api": "pnpm --filter @real-capita-accounts/api build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "prisma:generate": "prisma generate --schema prisma/schema.prisma",
    "prisma:migrate": "prisma migrate dev --schema prisma/schema.prisma",
    "prisma:studio": "prisma studio --schema prisma/schema.prisma"
  },
  "devDependencies": {
    "prisma": "^7.1.0",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@prisma/client": "^7.1.0"
  }
}
