{
  "name": "real-capita-accounts",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@11.1.2",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @real-capita-accounts/web --filter @real-capita-accounts/api dev",
    "dev:web": "pnpm --filter @real-capita-accounts/web dev",
    "dev:api": "pnpm --filter @real-capita-accounts/api dev",
    "build": "pnpm -r build",
    "build:web": "pnpm --filter @real-capita-accounts/web build",
    "build:api": "pnpm --filter @real-capita-accounts/api build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "agent:start": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/agent-start.ps1",
    "check:all": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/check-all.ps1",
    "doctor": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/doctor.ps1",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "tsx scripts/db/prisma-admin.ts dev",
    "prisma:deploy": "tsx scripts/db/prisma-admin.ts deploy",
    "prisma:status": "tsx scripts/db/prisma-admin.ts status",
    "verify:database:security": "tsx --tsconfig apps/api/tsconfig.json scripts/verify-database-role-security.ts",
    "prisma:studio": "prisma studio",
    "seed": "tsx prisma/seed.ts",
    "prisma:seed": "pnpm seed",
    "demo:audit": "tsx prisma/demo-audit.ts",
    "demo:reset": "tsx prisma/demo-reset.ts",
    "demo:verify": "tsx prisma/demo-verify.ts",
    "verify:payroll:foundation": "tsx --tsconfig apps/api/tsconfig.json scripts/verify-payroll-foundation.ts",
    "verify:payroll:read": "tsx --tsconfig apps/api/tsconfig.json scripts/verify-payroll-read.ts",
    "verify:payroll:documents": "tsx --tsconfig apps/api/tsconfig.json scripts/verify-payroll-documents.ts",
    "verify:payroll:print": "tsx --tsconfig apps/api/tsconfig.json scripts/verify-payroll-print.ts",
    "verify:payroll:navigation": "tsx --tsconfig apps/api/tsconfig.json scripts/verify-payroll-navigation.ts",
    "verify:payroll:payment-preparation": "tsx --tsconfig apps/api/tsconfig.json scripts/verify-payroll-payment-preparation.ts",
    "verify:payroll:payment-ui": "tsx --tsconfig apps/api/tsconfig.json scripts/verify-payroll-payment-ui.ts",
    "verify:payroll:payment-foundation": "tsx --tsconfig apps/api/tsconfig.json scripts/verify-payroll-payment-foundation.ts",
    "verify:payroll:calculation": "tsx --tsconfig apps/api/tsconfig.json scripts/verify-payroll-calculation.ts",
    "verify:payroll:readiness": "tsx --tsconfig apps/api/tsconfig.json scripts/verify-payroll-readiness.ts",
    "verify:payroll:draft": "tsx --tsconfig apps/api/tsconfig.json scripts/verify-payroll-draft.ts",
    "verify:payroll:attendance": "tsx --tsconfig apps/api/tsconfig.json scripts/verify-payroll-attendance.ts",
    "verify:payroll:database": "tsx --tsconfig apps/api/tsconfig.json scripts/verify-payroll-database.ts",
    "verify:payroll:preview": "tsx --tsconfig apps/api/tsconfig.json scripts/verify-payroll-preview.ts",
    "verify:payroll:approval-readiness": "tsx --tsconfig apps/api/tsconfig.json scripts/verify-payroll-approval-readiness.ts",
    "verify:payroll:approval": "tsx --tsconfig apps/api/tsconfig.json scripts/verify-payroll-approval.ts",
    "verify:payroll:correction-preflight": "tsx --tsconfig apps/api/tsconfig.json scripts/verify-payroll-correction-preflight.ts",
    "verify:payroll:acceptance": "tsx --tsconfig apps/api/tsconfig.json scripts/verify-payroll-acceptance.ts",
    "verify:attendance": "tsx --tsconfig apps/api/tsconfig.json scripts/verify-attendance.ts",
    "verify:attendance:concurrency": "tsx --tsconfig apps/api/tsconfig.json scripts/verify-attendance-concurrency.ts",
    "verify:attendance:constraints": "tsx --tsconfig apps/api/tsconfig.json scripts/verify-attendance-constraints.ts",
    "verify:attendance:database": "tsx --tsconfig apps/api/tsconfig.json scripts/verify-attendance-database.ts",
    "verify:attendance:runtime": "tsx --tsconfig apps/api/tsconfig.json scripts/verify-attendance-runtime.ts",
    "verify:employee-records": "tsx --tsconfig apps/api/tsconfig.json scripts/verify-employee-records.ts",
    "verify:employee-records:database": "tsx --tsconfig apps/api/tsconfig.json scripts/verify-employee-records-database.ts",
    "verify:work-schedules": "tsx --tsconfig apps/api/tsconfig.json scripts/verify-work-schedules.ts",
    "verify:work-schedules:database": "tsx --tsconfig apps/api/tsconfig.json scripts/verify-work-schedules-database.ts",
    "verify:work-schedules:runtime": "tsx --tsconfig apps/api/tsconfig.json scripts/verify-work-schedules-runtime.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@prisma/adapter-pg": "^7.8.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/node": "^25.9.3",
    "@types/pg": "^8.20.0",
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.2.3",
    "eslint": "^9.39.4",
    "prisma": "^7.1.0",
    "tsx": "^4.22.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.61.0"
  },
  "dependencies": {
    "@prisma/client": "^7.1.0"
  },
  "prisma": {
    "seed": "pnpm seed"
  }
}
