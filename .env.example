# API-only configuration. Never place migration/provisioning secrets in this file.
RUNTIME_DATABASE_URL=postgresql://rc_runtime:replace-runtime-secret@localhost:55532/real_capita_accounts_salary_dev?schema=public
RUNTIME_DATABASE_NAME=real_capita_accounts_salary_dev
# MIGRATION_DATABASE_URL belongs only to an authorized CLI environment.
# FINANCE_PROVISIONING_DATABASE_URL belongs only to a private authority worker.
API_PORT=4000
WEB_PORT=3000
WEB_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000
JWT_SECRET=replace-with-a-secure-secret
JWT_EXPIRES_IN=8h
COOKIE_NAME=rcg_auth
NODE_ENV=development
