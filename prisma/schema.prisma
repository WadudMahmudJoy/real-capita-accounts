generator client {
  provider     = "prisma-client"
  output       = "../apps/api/src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                        String                     @id @default(cuid())
  email                     String                     @unique
  fullName                  String
  passwordHash              String
  isActive                  Boolean                    @default(true)
  lastLoginAt               DateTime?
  createdAt                 DateTime                   @default(now())
  updatedAt                 DateTime                   @updatedAt
  roles                     UserRole[]
  sessions                  AuthSession[]
  auditEvents               AuditEvent[]
  createdVouchers           Voucher[]                  @relation("VoucherCreatedBy")
  postedVouchers            Voucher[]                  @relation("VoucherPostedBy")
  createdSalaryStructures   SalaryStructure[]          @relation("SalaryStructureCreatedBy")
  approvedSalaryStructures  SalaryStructure[]          @relation("SalaryStructureApprovedBy")
  createdSalaryAssignments  EmployeeSalaryAssignment[] @relation("SalaryAssignmentCreatedBy")
  approvedSalaryAssignments EmployeeSalaryAssignment[] @relation("SalaryAssignmentApprovedBy")
  createdPaymentProfiles    EmployeePaymentProfile[]   @relation("PaymentProfileCreatedBy")
  approvedPaymentProfiles   EmployeePaymentProfile[]   @relation("PaymentProfileApprovedBy")

  createdWorkSchedules       WorkSchedule[]           @relation("WorkScheduleCreatedBy")
  createdScheduleAssignments WorkScheduleAssignment[] @relation("WorkScheduleAssignmentCreatedBy")

  createdAttendanceRevisions    AttendanceRevision[]        @relation("AttendanceRevisionCreatedBy")
  finalizedAttendanceRevisions  AttendanceRevision[]        @relation("AttendanceRevisionFinalizedBy")
  finalizedAttendanceDays       AttendanceDayFinalization[] @relation("AttendanceDayFinalizationFinalizedBy")
  createdAttendancePolicies     AttendancePolicy[]          @relation("AttendancePolicyCreatedBy")
  cancelledAttendancePolicies   AttendancePolicy[]          @relation("AttendancePolicyCancelledBy")
  createdCalendarExceptions     CompanyCalendarException[]  @relation("CalendarExceptionCreatedBy")
  supersededCalendarExceptions  CompanyCalendarException[]  @relation("CalendarExceptionSupersededBy")
  cancelledCalendarExceptions   CompanyCalendarException[]  @relation("CalendarExceptionCancelledBy")

  @@map("users")
}

model Role {
  id          String     @id @default(cuid())
  code        String     @unique
  name        String
  description String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  users       UserRole[]

  @@map("roles")
}

model UserRole {
  id        String   @id @default(cuid())
  userId    String
  roleId    String
  createdAt DateTime @default(now())
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@index([roleId])
  @@map("user_roles")
}

model AuthSession {
  id              String    @id @default(cuid())
  userId          String
  activeCompanyId String?
  tokenId         String    @unique
  expiresAt       DateTime
  revokedAt       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  activeCompany   Company?  @relation("AuthSessionActiveCompany", fields: [activeCompanyId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([expiresAt])
  @@index([activeCompanyId])
  @@map("auth_sessions")
}

model AuditEvent {
  id         String   @id @default(cuid())
  userId     String?
  action     String
  entityType String?
  entityId   String?
  ipAddress  String?
  userAgent  String?
  metadata   Json?
  createdAt  DateTime @default(now())
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_events")
}

// ---------------------------------------------------------------------------
// Phase 2A: Accounting Foundation
// ---------------------------------------------------------------------------

enum AccountClassCode {
  ASSET
  LIABILITY
  EQUITY
  INCOME
  EXPENSE
}

enum NormalBalanceSide {
  DEBIT
  CREDIT
}

enum AccountingPeriodStatus {
  OPEN
  LOCKED
  CLOSED
}

enum CashBankAccountType {
  CASH
  BANK
  MFS
}

enum MfsProvider {
  BKASH
  NAGAD
  ROCKET
  UPAY
  OTHER
}

// ---------------------------------------------------------------------------
// Phase 2C: Voucher Schema Foundation
// ---------------------------------------------------------------------------

enum VoucherType {
  DEBIT
  CREDIT
  JOURNAL
  CONTRA
  PAYMENT
  RECEIPT
}

enum VoucherStatus {
  DRAFT
  POSTED
}

enum VoucherLineSide {
  DEBIT
  CREDIT
}

enum CustomerType {
  INDIVIDUAL
  COMPANY
  OTHER
}

enum BookableItemCategory {
  LAND
  PLOT
  FLAT
  UNIT
  SHARE
  OTHER
}

enum BookableItemStatus {
  AVAILABLE
  HOLD
  BOOKED
  SOLD
  CANCELLED
}

enum BookingAdministrativeStatus {
  DRAFT
  ACTIVE
  HOLD
  CANCELLED
  REFUNDED
}

enum SalaryConfigurationStatus {
  DRAFT
  APPROVED
  INACTIVE
}

enum BloodGroup {
  A_POSITIVE
  A_NEGATIVE
  B_POSITIVE
  B_NEGATIVE
  AB_POSITIVE
  AB_NEGATIVE
  O_POSITIVE
  O_NEGATIVE
}

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum WorkScheduleAssignmentScope {
  COMPANY_DEFAULT
  EMPLOYEE_OVERRIDE
}

enum AttendancePresenceState {
  PRESENT
  ABSENT
  INCOMPLETE
  NOT_REQUIRED
}

enum AttendanceOrigin {
  MANUAL_ENTRY
  MANUAL_CORRECTION
  SYSTEM_FINALIZATION
}

enum AttendanceExpectedDayKind {
  WORKING_DAY
  WEEKLY_REST
  HOLIDAY
  SPECIAL_WORKING_DAY
}

enum CompanyCalendarExceptionType {
  HOLIDAY
  SPECIAL_WORKING_DAY
}

model Department {
  id          String     @id @default(cuid())
  code        String     @unique
  name        String
  description String?
  isActive    Boolean    @default(true)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  employees   Employee[]

  @@index([isActive])
  @@map("departments")
}

model Employee {
  id                           String                     @id @default(cuid())
  employeeCode                 String                     @unique
  fullName                     String
  bengaliName                  String?
  dateOfBirth                  DateTime?
  nationalId                   String?                    @unique
  bloodGroup                   BloodGroup?
  mobileNumber                 String?
  alternateMobileNumber        String?
  personalEmail                String?
  officialEmail                String?                    @unique
  presentAddress               String?
  permanentAddress             String?
  designation                  String
  departmentId                 String?
  joiningDate                  DateTime
  confirmationDate             DateTime?
  separationDate               DateTime?
  separationReason             String?
  emergencyContactName         String?
  emergencyContactRelationship String?
  emergencyContactMobile       String?
  emergencyContactAddress      String?
  isActive                     Boolean                    @default(true)
  isDeleted                    Boolean                    @default(false)
  deletedAt                    DateTime?
  createdAt                    DateTime                   @default(now())
  updatedAt                    DateTime                   @updatedAt
  department                   Department?                @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  salaryAssignments            EmployeeSalaryAssignment[]
  paymentProfiles              EmployeePaymentProfile[]

  workScheduleAssignments WorkScheduleAssignment[]

  attendanceRecords AttendanceRecord[]

  @@index([departmentId])
  @@index([isActive])
  @@index([isDeleted])
  @@map("employees")
}

model SalaryStructure {
  id                String                     @id @default(cuid())
  code              String
  version           Int
  name              String
  description       String?
  effectiveFrom     DateTime
  effectiveTo       DateTime?
  status            SalaryConfigurationStatus  @default(DRAFT)
  createdById       String
  approvedById      String?
  approvedAt        DateTime?
  createdAt         DateTime                   @default(now())
  updatedAt         DateTime                   @updatedAt
  createdBy         User                       @relation("SalaryStructureCreatedBy", fields: [createdById], references: [id])
  approvedBy        User?                      @relation("SalaryStructureApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  components        SalaryStructureComponent[]
  salaryAssignments EmployeeSalaryAssignment[]

  @@unique([code, version])
  @@index([status])
  @@index([effectiveFrom, effectiveTo])
  @@map("salary_structures")
}

model SalaryStructureComponent {
  id                String          @id @default(cuid())
  salaryStructureId String
  code              String
  name              String
  percentage        Decimal         @db.Decimal(7, 4)
  displayOrder      Int
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  salaryStructure   SalaryStructure @relation(fields: [salaryStructureId], references: [id], onDelete: Cascade)

  @@unique([salaryStructureId, code])
  @@unique([salaryStructureId, displayOrder])
  @@map("salary_structure_components")
}

model EmployeeSalaryAssignment {
  id                String                    @id @default(cuid())
  employeeId        String
  salaryStructureId String
  grossSalary       Decimal                   @db.Decimal(18, 2)
  effectiveFrom     DateTime
  effectiveTo       DateTime?
  status            SalaryConfigurationStatus @default(DRAFT)
  changeReason      String?
  createdById       String
  approvedById      String?
  approvedAt        DateTime?
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt
  employee          Employee                  @relation(fields: [employeeId], references: [id])
  salaryStructure   SalaryStructure           @relation(fields: [salaryStructureId], references: [id])
  createdBy         User                      @relation("SalaryAssignmentCreatedBy", fields: [createdById], references: [id])
  approvedBy        User?                     @relation("SalaryAssignmentApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)

  @@index([employeeId, effectiveFrom])
  @@index([employeeId, status])
  @@index([salaryStructureId])
  @@map("employee_salary_assignments")
}

model EmployeePaymentProfile {
  id                     String                    @id @default(cuid())
  employeeId             String
  selectedBankPercentage Decimal                   @default(60) @db.Decimal(9, 6)
  bankName               String?
  accountName            String?
  accountNumber          String?
  branchName             String?
  effectiveFrom          DateTime
  effectiveTo            DateTime?
  status                 SalaryConfigurationStatus @default(DRAFT)
  changeReason           String?
  createdById            String
  approvedById           String?
  approvedAt             DateTime?
  createdAt              DateTime                  @default(now())
  updatedAt              DateTime                  @updatedAt
  employee               Employee                  @relation(fields: [employeeId], references: [id])
  createdBy              User                      @relation("PaymentProfileCreatedBy", fields: [createdById], references: [id])
  approvedBy             User?                     @relation("PaymentProfileApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)

  @@index([employeeId, effectiveFrom])
  @@index([employeeId, status])
  @@map("employee_payment_profiles")
}

enum CompanyBackgroundMode {
  DEFAULT_PREMIUM
  CUSTOM
}

model Company {
  id                     String                  @id @default(cuid())
  singletonKey           String?                 @unique
  name                   String
  legalName              String?
  address                String?
  phone                  String?
  email                  String?
  currency               String                  @default("BDT")
  isActive               Boolean                 @default(true)
  officeLogoPath         String?
  brandAccentColor       String?
  backgroundMode         CompanyBackgroundMode   @default(DEFAULT_PREMIUM)
  customBackgroundPath   String?
  printLogoPath          String?
  printHeaderName        String?
  printFooterText        String?
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  activeSessions         AuthSession[]           @relation("AuthSessionActiveCompany")
  fiscalYears            FiscalYear[]
  vouchers               Voucher[]
  voucherNumberSequences VoucherNumberSequence[]

  workSchedules           WorkSchedule[]
  workScheduleAssignments WorkScheduleAssignment[]

  attendanceRecords          AttendanceRecord[]
  attendanceDayFinalizations AttendanceDayFinalization[]
  attendancePolicies         AttendancePolicy[]
  companyCalendarExceptions  CompanyCalendarException[]

  @@map("companies")
}

model WorkSchedule {
  id          String                   @id @default(cuid())
  companyId   String
  code        String                   @db.VarChar(32)
  name        String
  description String?
  isActive    Boolean                  @default(true)
  createdById String
  createdAt   DateTime                 @default(now())
  updatedAt   DateTime                 @updatedAt
  company     Company                  @relation(fields: [companyId], references: [id], onDelete: Restrict)
  createdBy   User                     @relation("WorkScheduleCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  days        WorkScheduleDay[]
  assignments WorkScheduleAssignment[]

  @@unique([companyId, code])
  @@unique([id, companyId])
  @@map("work_schedules")
}

model WorkScheduleDay {
  id                 String       @id @default(cuid())
  workScheduleId     String
  dayOfWeek          DayOfWeek
  isWorkingDay       Boolean
  startMinuteOfDay   Int?
  endMinuteOfDay     Int?
  unpaidBreakMinutes Int          @default(0)
  crossesMidnight    Boolean      @default(false)
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
  workSchedule       WorkSchedule @relation(fields: [workScheduleId], references: [id], onDelete: Restrict)

  @@unique([workScheduleId, dayOfWeek])
  @@map("work_schedule_days")
}

model WorkScheduleAssignment {
  id                     String                      @id @default(cuid())
  companyId              String
  scope                  WorkScheduleAssignmentScope
  workScheduleId         String
  employeeId             String?
  effectiveFrom          DateTime                    @db.Date
  effectiveTo            DateTime?                   @db.Date
  changeReason           String?
  createdById            String
  createdAt              DateTime                    @default(now())
  updatedAt              DateTime                    @updatedAt
  cancelledAt            DateTime?
  replacesAssignmentId   String?
  company                Company                     @relation(fields: [companyId], references: [id], onDelete: Restrict)
  workSchedule           WorkSchedule                @relation(fields: [workScheduleId, companyId], references: [id, companyId], onDelete: Restrict)
  employee               Employee?                   @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  createdBy              User                        @relation("WorkScheduleAssignmentCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  replacesAssignment     WorkScheduleAssignment?     @relation("WorkScheduleAssignmentReplacement", fields: [replacesAssignmentId], references: [id], onDelete: Restrict)
  replacementAssignments WorkScheduleAssignment[]    @relation("WorkScheduleAssignmentReplacement")
  attendanceRevisions    AttendanceRevision[]

  @@index([companyId, effectiveFrom])
  @@index([employeeId, effectiveFrom])
  @@index([workScheduleId])
  @@index([createdById])
  @@index([replacesAssignmentId])
  @@map("work_schedule_assignments")
}

model AttendanceRecord {
  id           String   @id @default(cuid())
  companyId    String
  employeeId   String
  businessDate DateTime @db.Date
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  company      Company  @relation(fields: [companyId], references: [id], onDelete: Restrict)
  employee     Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  revisions    AttendanceRevision[]

  @@unique([employeeId, businessDate])
  @@index([companyId, businessDate])
  @@map("attendance_records")
}

model AttendanceRevision {
  id                        String                    @id @default(cuid())
  attendanceRecordId        String
  revisionNo                Int
  origin                    AttendanceOrigin
  isAttendanceApplicable    Boolean?
  checkInAt                 DateTime?
  checkOutAt                DateTime?
  note                      String?                   @db.VarChar(500)
  expectedDayKind           AttendanceExpectedDayKind?
  workScheduleAssignmentId  String?
  workScheduleSource        WorkScheduleAssignmentScope?
  calendarExceptionId       String?
  attendancePolicyId        String?
  scheduledStartMinute      Int?
  scheduledEndMinute        Int?
  crossesMidnight           Boolean?
  unpaidBreakMinutes        Int?
  expectedWorkMinutes       Int?
  lateGraceMinutes          Int?
  earlyLeaveGraceMinutes    Int?
  timeZone                  String?                   @db.VarChar(64)
  presenceState             AttendancePresenceState?
  isLate                    Boolean?
  isEarlyLeave              Boolean?
  isNonWorkingDayAttendance Boolean?
  arrivalDelayMinutes       Int?
  earlyDepartureMinutes     Int?
  changeReason              String?                   @db.VarChar(500)
  createdById               String
  finalizedById             String?
  finalizedAt               DateTime?
  createdAt                 DateTime                  @default(now())
  updatedAt                 DateTime                  @updatedAt
  attendanceRecord          AttendanceRecord          @relation(fields: [attendanceRecordId], references: [id], onDelete: Restrict)
  workScheduleAssignment    WorkScheduleAssignment?   @relation(fields: [workScheduleAssignmentId], references: [id], onDelete: Restrict)
  calendarException         CompanyCalendarException? @relation(fields: [calendarExceptionId], references: [id], onDelete: Restrict)
  attendancePolicy          AttendancePolicy?         @relation(fields: [attendancePolicyId], references: [id], onDelete: Restrict)
  createdBy                 User                      @relation("AttendanceRevisionCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  finalizedBy               User?                     @relation("AttendanceRevisionFinalizedBy", fields: [finalizedById], references: [id], onDelete: Restrict)

  @@unique([attendanceRecordId, revisionNo])
  @@index([attendanceRecordId, finalizedAt])
  @@index([createdById])
  @@index([finalizedById])
  @@index([attendancePolicyId])
  @@index([calendarExceptionId])
  @@index([workScheduleAssignmentId])
  @@map("attendance_revisions")
}

model AttendanceDayFinalization {
  id            String   @id @default(cuid())
  companyId     String
  businessDate  DateTime @db.Date
  finalizedAt   DateTime
  finalizedById String
  company       Company  @relation(fields: [companyId], references: [id], onDelete: Restrict)
  finalizedBy   User     @relation("AttendanceDayFinalizationFinalizedBy", fields: [finalizedById], references: [id], onDelete: Restrict)

  @@unique([companyId, businessDate])
  @@index([finalizedById])
  @@map("attendance_day_finalizations")
}

model AttendancePolicy {
  id                    String    @id @default(cuid())
  companyId             String
  effectiveFrom         DateTime  @db.Date
  effectiveTo           DateTime? @db.Date
  lateGraceMinutes      Int
  earlyLeaveGraceMinutes Int
  changeReason          String?   @db.VarChar(500)
  replacesPolicyId      String?
  cancelledAt           DateTime?
  cancelledById         String?
  cancellationReason    String?   @db.VarChar(500)
  createdById           String
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  company               Company   @relation(fields: [companyId], references: [id], onDelete: Restrict)
  createdBy             User      @relation("AttendancePolicyCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  cancelledBy           User?     @relation("AttendancePolicyCancelledBy", fields: [cancelledById], references: [id], onDelete: Restrict)
  replacesPolicy        AttendancePolicy?  @relation("AttendancePolicyReplacement", fields: [replacesPolicyId], references: [id], onDelete: Restrict)
  replacementPolicies   AttendancePolicy[] @relation("AttendancePolicyReplacement")
  revisions             AttendanceRevision[]

  @@index([companyId, effectiveFrom])
  @@index([replacesPolicyId])
  @@index([createdById])
  @@index([cancelledById])
  @@map("attendance_policies")
}

model CompanyCalendarException {
  id                  String                     @id @default(cuid())
  companyId           String
  businessDate        DateTime                   @db.Date
  exceptionType       CompanyCalendarExceptionType
  name                String                     @db.VarChar(150)
  startMinuteOfDay    Int?
  endMinuteOfDay      Int?
  unpaidBreakMinutes  Int                        @default(0)
  crossesMidnight     Boolean                    @default(false)
  changeReason        String?                    @db.VarChar(500)
  replacesExceptionId String?
  supersededAt        DateTime?
  supersededById      String?
  cancelledAt         DateTime?
  cancelledById       String?
  cancellationReason  String?                    @db.VarChar(500)
  createdById         String
  createdAt           DateTime                   @default(now())
  updatedAt           DateTime                   @updatedAt
  company             Company                    @relation(fields: [companyId], references: [id], onDelete: Restrict)
  createdBy           User                       @relation("CalendarExceptionCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  supersededBy        User?                      @relation("CalendarExceptionSupersededBy", fields: [supersededById], references: [id], onDelete: Restrict)
  cancelledBy         User?                      @relation("CalendarExceptionCancelledBy", fields: [cancelledById], references: [id], onDelete: Restrict)
  replacesException   CompanyCalendarException?  @relation("CalendarExceptionReplacement", fields: [replacesExceptionId, companyId, businessDate], references: [id, companyId, businessDate], onDelete: Restrict)
  replacementExceptions CompanyCalendarException[] @relation("CalendarExceptionReplacement")
  revisions           AttendanceRevision[]

  @@unique([id, companyId, businessDate])
  @@index([companyId, businessDate])
  @@index([replacesExceptionId])
  @@index([supersededById])
  @@index([cancelledById])
  @@index([createdById])
  @@map("company_calendar_exceptions")
}

model FiscalYear {
  id                     String                  @id @default(cuid())
  companyId              String
  name                   String
  startDate              DateTime
  endDate                DateTime
  isActive               Boolean                 @default(false)
  isClosed               Boolean                 @default(false)
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  company                Company                 @relation(fields: [companyId], references: [id])
  periods                AccountingPeriod[]
  vouchers               Voucher[]
  voucherNumberSequences VoucherNumberSequence[]

  // A fiscal year should not be both active and closed at the same time.
  // Application logic must maintain this invariant.

  @@map("fiscal_years")
}

model AccountingPeriod {
  id           String                 @id @default(cuid())
  fiscalYearId String
  name         String
  startDate    DateTime
  endDate      DateTime
  status       AccountingPeriodStatus @default(OPEN)
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt
  fiscalYear   FiscalYear             @relation(fields: [fiscalYearId], references: [id])
  vouchers     Voucher[]

  @@map("accounting_periods")
}

model Project {
  id           String        @id @default(cuid())
  code         String        @unique
  name         String
  location     String?
  isActive     Boolean       @default(true)
  notes        String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  bookableItems BookableItem[]
  bookings      Booking[]
  costCenters  CostCenter[]
  voucherLines VoucherLine[]

  @@map("projects")
}

model CostCenter {
  id           String        @id @default(cuid())
  projectId    String
  code         String
  name         String
  description  String?
  isActive     Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  project      Project       @relation(fields: [projectId], references: [id])
  voucherLines VoucherLine[]

  @@unique([projectId, code])
  @@map("cost_centers")
}

model AccountClass {
  id            String            @id @default(cuid())
  code          AccountClassCode  @unique
  name          String
  normalBalance NormalBalanceSide
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  groups        AccountGroup[]

  @@map("account_classes")
}

model AccountGroup {
  id             String          @id @default(cuid())
  accountClassId String
  code           String          @unique
  name           String
  description    String?
  isActive       Boolean         @default(true)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  accountClass   AccountClass    @relation(fields: [accountClassId], references: [id])
  ledgerAccounts LedgerAccount[]

  @@map("account_groups")
}

model LedgerAccount {
  id                 String            @id @default(cuid())
  accountGroupId     String
  code               String            @unique
  name               String
  normalBalance      NormalBalanceSide
  requiresProject    Boolean           @default(false)
  requiresCostCenter Boolean           @default(false)
  isCashBank         Boolean           @default(false)
  isActive           Boolean           @default(true)
  description        String?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  accountGroup       AccountGroup      @relation(fields: [accountGroupId], references: [id])
  cashBankAccounts   CashBankAccount[]
  voucherLines       VoucherLine[]

  @@map("ledger_accounts")
}

model CashBankAccount {
  id                String              @id @default(cuid())
  ledgerAccountId   String              @unique
  displayName       String
  accountType       CashBankAccountType
  bankName          String?
  branch            String?
  accountNumber     String?
  provider          MfsProvider?
  providerOtherName String?
  walletNumber      String?
  accountHolderName String?
  isActive          Boolean             @default(true)
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  ledgerAccount     LedgerAccount       @relation(fields: [ledgerAccountId], references: [id])
  voucherLines      VoucherLine[]

  @@map("cash_bank_accounts")
}

model Voucher {
  id                 String           @id @default(cuid())
  companyId          String
  fiscalYearId       String
  accountingPeriodId String
  voucherType        VoucherType
  status             VoucherStatus    @default(DRAFT)
  systemVoucherNo    String
  physicalSiNo       String?
  voucherDate        DateTime
  postingDate        DateTime?
  narration          String?
  totalDebit         Decimal          @db.Decimal(18, 2)
  totalCredit        Decimal          @db.Decimal(18, 2)
  createdById        String
  postedById         String?
  isDeleted          Boolean          @default(false)
  deletedAt          DateTime?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  company            Company          @relation(fields: [companyId], references: [id])
  fiscalYear         FiscalYear       @relation(fields: [fiscalYearId], references: [id])
  accountingPeriod   AccountingPeriod @relation(fields: [accountingPeriodId], references: [id])
  createdBy          User             @relation("VoucherCreatedBy", fields: [createdById], references: [id])
  postedBy           User?            @relation("VoucherPostedBy", fields: [postedById], references: [id], onDelete: SetNull)
  reversalOfVoucherId String?          @unique
  correctionReason   String?
  reversalOf         Voucher?         @relation("VoucherReversal", fields: [reversalOfVoucherId], references: [id])
  reversedBy         Voucher?         @relation("VoucherReversal")
  bookingReceiptAllocations BookingReceiptAllocation[]
  lines              VoucherLine[]

  @@unique([companyId, fiscalYearId, systemVoucherNo])
  @@index([companyId])
  @@index([fiscalYearId])
  @@index([accountingPeriodId])
  @@index([voucherDate])
  @@index([status])
  @@index([voucherType])
  @@map("vouchers")
}

model Customer {
  id                  String     @id @default(cuid())
  customerCode        String     @unique
  customerType        CustomerType @default(INDIVIDUAL)
  name                String
  phone               String
  email               String?
  nidOrPassport       String?    @unique
  address             String
  professionOrBusiness String?
  nomineeOrReference  String?
  notes               String?
  isActive            Boolean    @default(true)
  isDeleted           Boolean    @default(false)
  deletedAt           DateTime?
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt
  bookings            Booking[]

  @@index([customerType])
  @@index([isActive])
  @@index([isDeleted])
  @@map("customers")
}

model BookableItem {
  id             String                @id @default(cuid())
  itemCode       String                @unique
  projectId      String
  category       BookableItemCategory
  itemIdentifier String
  block          String?
  zone           String?
  phase          String?
  sizeOrArea     String?
  shareQuantity  Decimal?              @db.Decimal(18, 2)
  basePrice      Decimal               @db.Decimal(18, 2)
  status         BookableItemStatus     @default(AVAILABLE)
  notes          String?
  isDeleted      Boolean               @default(false)
  deletedAt      DateTime?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  project        Project               @relation(fields: [projectId], references: [id])
  bookings       Booking[]

  @@unique([projectId, category, itemIdentifier])
  @@index([projectId])
  @@index([category])
  @@index([status])
  @@index([isDeleted])
  @@map("bookable_items")
}

model Booking {
  id                   String                      @id @default(cuid())
  bookingNumber        String                      @unique
  customerId           String
  projectId            String
  bookableItemId       String
  bookingDate          DateTime
  totalAgreedPrice     Decimal                     @db.Decimal(18, 2)
  discountAmount       Decimal                     @default(0) @db.Decimal(18, 2)
  netBookingValue      Decimal                     @db.Decimal(18, 2)
  bookingMoney         Decimal?                    @db.Decimal(18, 2)
  administrativeStatus BookingAdministrativeStatus @default(DRAFT)
  remarks              String?
  isDeleted            Boolean                     @default(false)
  deletedAt            DateTime?
  createdAt            DateTime                    @default(now())
  updatedAt            DateTime                    @updatedAt
  customer             Customer                    @relation(fields: [customerId], references: [id])
  project              Project                     @relation(fields: [projectId], references: [id])
  bookableItem         BookableItem                @relation(fields: [bookableItemId], references: [id])
  installments         BookingInstallment[]
  receiptAllocations   BookingReceiptAllocation[]

  @@index([customerId])
  @@index([projectId])
  @@index([bookableItemId])
  @@index([administrativeStatus])
  @@index([bookingDate])
  @@index([isDeleted])
  @@map("bookings")
}

model BookingInstallment {
  id            String   @id @default(cuid())
  bookingId     String
  installmentNo Int
  dueDate       DateTime
  amount        Decimal  @db.Decimal(18, 2)
  description   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  booking       Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@unique([bookingId, installmentNo])
  @@index([bookingId])
  @@index([dueDate])
  @@map("booking_installments")
}

model BookingReceiptAllocation {
  id                 String   @id @default(cuid())
  bookingId          String
  voucherId          String
  amount             Decimal  @db.Decimal(18, 2)
  allocationDate     DateTime
  allocationReference String?
  notes              String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  booking            Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  voucher            Voucher  @relation(fields: [voucherId], references: [id])

  @@index([bookingId])
  @@index([voucherId])
  @@index([allocationDate])
  @@map("booking_receipt_allocations")
}

model VoucherLine {
  id                String           @id @default(cuid())
  voucherId         String
  lineNo            Int
  side              VoucherLineSide
  ledgerAccountId   String
  projectId         String?
  costCenterId      String?
  cashBankAccountId String?
  description       String?
  amount            Decimal          @db.Decimal(18, 2)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  voucher           Voucher          @relation(fields: [voucherId], references: [id], onDelete: Cascade)
  ledgerAccount     LedgerAccount    @relation(fields: [ledgerAccountId], references: [id])
  project           Project?         @relation(fields: [projectId], references: [id], onDelete: SetNull)
  costCenter        CostCenter?      @relation(fields: [costCenterId], references: [id], onDelete: SetNull)
  cashBankAccount   CashBankAccount? @relation(fields: [cashBankAccountId], references: [id], onDelete: SetNull)

  @@unique([voucherId, lineNo])
  @@index([ledgerAccountId])
  @@index([projectId])
  @@index([costCenterId])
  @@index([cashBankAccountId])
  @@map("voucher_lines")
}

model VoucherNumberSequence {
  id           String      @id @default(cuid())
  companyId    String
  fiscalYearId String
  voucherType  VoucherType
  prefix       String?
  nextNumber   Int         @default(1)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  company      Company     @relation(fields: [companyId], references: [id])
  fiscalYear   FiscalYear  @relation(fields: [fiscalYearId], references: [id])

  @@unique([companyId, fiscalYearId, voucherType])
  @@map("voucher_number_sequences")
}
