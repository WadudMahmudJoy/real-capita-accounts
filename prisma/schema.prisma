model Department {
  id          String     @id @default(cuid())
  code        String     @unique
  name        String
  description String?
  isActive    Boolean    @default(true)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  employees   Employee[]

  @@index([isActive])
  @@map("departments")
}

model Employee {
  leaveStageDecisions LeaveStageDecision[] // SPRINT7D
  accountBindings EmployeeAccountBinding[] // HR4
  leaveRequests LeaveRequest[]

  payrollPaymentLines PayrollPaymentLine[]

  id                           String                     @id @default(cuid())
  employeeCode                 String                     @unique
  fullName                     String
  bengaliName                  String?
  dateOfBirth                  DateTime?
  nationalId                   String?                    @unique
  bloodGroup                   BloodGroup?
  mobileNumber                 String?
  alternateMobileNumber        String?
  personalEmail                String?
  officialEmail                String?                    @unique
  presentAddress               String?
  permanentAddress             String?
  designation                  String
  departmentId                 String?
  joiningDate                  DateTime
  confirmationDate             DateTime?
  separationDate               DateTime?
  separationReason             String?
  emergencyContactName         String?
  emergencyContactRelationship String?
  emergencyContactMobile       String?
  emergencyContactAddress      String?
  isActive                     Boolean                    @default(true)
  isDeleted                    Boolean                    @default(false)
  deletedAt                    DateTime?
  createdAt                    DateTime                   @default(now())
  updatedAt                    DateTime                   @updatedAt
  department                   Department?                @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  salaryAssignments            EmployeeSalaryAssignment[]
  paymentProfiles              EmployeePaymentProfile[]
  payrollRunLines              PayrollRunLine[]

  workScheduleAssignments WorkScheduleAssignment[]

  attendanceRecords AttendanceRecord[]

  @@index([departmentId])
  @@index([isActive])
  @@index([isDeleted])
  @@map("employees")
  onboardingIdentity OnboardingIdentity[]

}

model SalaryStructure {
  id                String                     @id @default(cuid())
  code              String
  version           Int
  name              String
  description       String?
  effectiveFrom     DateTime
  effectiveTo       DateTime?
  status            SalaryConfigurationStatus  @default(DRAFT)
  createdById       String
  approvedById      String?
  approvedAt        DateTime?
  createdAt         DateTime                   @default(now())
  updatedAt         DateTime                   @updatedAt
  createdBy         User                       @relation("SalaryStructureCreatedBy", fields: [createdById], references: [id])
  approvedBy        User?                      @relation("SalaryStructureApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  components        SalaryStructureComponent[]
  salaryAssignments EmployeeSalaryAssignment[]
  payrollRunLines   PayrollRunLine[]

  @@unique([code, version])
  @@index([status])
  @@index([effectiveFrom, effectiveTo])
  @@map("salary_structures")
}

model SalaryStructureComponent {
  id                String          @id @default(cuid())
  salaryStructureId String
  code              String
  name              String
  percentage        Decimal         @db.Decimal(7, 4)
  displayOrder      Int
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  salaryStructure   SalaryStructure @relation(fields: [salaryStructureId], references: [id], onDelete: Cascade)

  @@unique([salaryStructureId, code])
  @@unique([salaryStructureId, displayOrder])
  @@map("salary_structure_components")
}

model EmployeeSalaryAssignment {
  id                String                    @id @default(cuid())
  employeeId        String
  salaryStructureId String
  grossSalary       Decimal                   @db.Decimal(18, 2)
  effectiveFrom     DateTime
  effectiveTo       DateTime?
  status            SalaryConfigurationStatus @default(DRAFT)
  changeReason      String?
  createdById       String
  approvedById      String?
  approvedAt        DateTime?
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt
  employee          Employee                  @relation(fields: [employeeId], references: [id])
  salaryStructure   SalaryStructure           @relation(fields: [salaryStructureId], references: [id])
  createdBy         User                      @relation("SalaryAssignmentCreatedBy", fields: [createdById], references: [id])
  approvedBy        User?                     @relation("SalaryAssignmentApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  payrollRunLines   PayrollRunLine[]

  @@index([employeeId, effectiveFrom])
  @@index([employeeId, status])
  @@index([salaryStructureId])
  @@map("employee_salary_assignments")
}

model EmployeePaymentProfile {
  id                     String                    @id @default(cuid())
  employeeId             String
  selectedBankPercentage Decimal                   @default(60) @db.Decimal(9, 6)
  bankName               String?
  accountName            String?
  accountNumber          String?
  branchName             String?
  effectiveFrom          DateTime
  effectiveTo            DateTime?
  status                 SalaryConfigurationStatus @default(DRAFT)
  changeReason           String?
  createdById            String
  approvedById           String?
  approvedAt             DateTime?
  createdAt              DateTime                  @default(now())
  updatedAt              DateTime                  @updatedAt
  employee               Employee                  @relation(fields: [employeeId], references: [id])
  createdBy              User                      @relation("PaymentProfileCreatedBy", fields: [createdById], references: [id])
  approvedBy             User?                     @relation("PaymentProfileApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  payrollRunLines        PayrollRunLine[]

  @@index([employeeId, effectiveFrom])
  @@index([employeeId, status])
  @@map("employee_payment_profiles")
}

// Central regular payroll only; no office allocation or payment lifecycle.
enum PayrollRunStatus {
  DRAFT
  APPROVED
}

model PayrollRun {
  paymentBatches PayrollPaymentBatch[]

  id                     String           @id @default(cuid())
  // Resolve Company.singletonKey = PRIMARY in trusted backend code, never the
  // active office. This FK alone does not enforce the designated parent.
  // Verify the actual existing parent record before migration execution.
  companyId              String
  payrollYear            Int
  payrollMonth           Int
  status                 PayrollRunStatus @default(DRAFT)
  version                Int              @default(1)
  createdById            String
  approvedById           String?
  approvedAt             DateTime?
  // Required versioned snapshot of parent identity/currency, not a live join.
  companySnapshot        Json
  snapshotSchemaVersion  Int              @default(1)
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt
  company                Company          @relation(fields: [companyId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  createdBy              User             @relation("PayrollRunCreatedBy", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Restrict)
  approvedBy             User?            @relation("PayrollRunApprovedBy", fields: [approvedById], references: [id], onDelete: Restrict, onUpdate: Restrict)
  lines                  PayrollRunLine[]

  // One centralized regular run per month across all offices. Together with
  // line uniqueness this prevents duplicate employee/month inclusion.
  @@unique([payrollYear, payrollMonth])
  @@index([companyId, status])
  @@index([createdById])
  @@index([approvedById])
  @@map("payroll_runs")
}

model PayrollRunLine {
  paymentReservations PayrollPaymentReservation[]

  paymentInstructions PayrollPaymentLine[]

  id                             String                    @id @default(cuid())
  payrollRunId                   String
  employeeId                     String
  salaryAssignmentId             String
  salaryStructureId              String
  paymentProfileId               String
  // Required snapshots must capture identity, effective ranges, structure
  // version/ordered components, bank details, inputs, deductions and rounding.
  // Encode all JSON money/percentages as decimal strings; never JS numbers.
  // Backend validates payloads/source consistency and freezes approved history.
  employeeSnapshot               Json
  salarySnapshot                 Json
  paymentProfileSnapshot         Json
  calculationSnapshot            Json
  grossSalary                    Decimal                   @db.Decimal(18, 2)
  totalEarnings                  Decimal                   @db.Decimal(18, 2)
  attendanceDeduction            Decimal                   @db.Decimal(18, 2)
  providentFundDeduction          Decimal                   @db.Decimal(18, 2)
  loanOrSalaryAdvanceDeduction    Decimal                   @db.Decimal(18, 2)
  aitDeduction                   Decimal                   @db.Decimal(18, 2)
  otherDeductionsTotal            Decimal                   @db.Decimal(18, 2)
  totalDeductions                Decimal                   @db.Decimal(18, 2)
  netPay                         Decimal                   @db.Decimal(18, 2)
  bankPay                        Decimal                   @db.Decimal(18, 2)
  cashPay                        Decimal                   @db.Decimal(18, 2)
  createdAt                      DateTime                  @default(now())
  updatedAt                      DateTime                  @updatedAt
  payrollRun                     PayrollRun                @relation(fields: [payrollRunId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  employee                       Employee                  @relation(fields: [employeeId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  salaryAssignment               EmployeeSalaryAssignment  @relation(fields: [salaryAssignmentId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  salaryStructure                SalaryStructure           @relation(fields: [salaryStructureId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  paymentProfile                 EmployeePaymentProfile    @relation(fields: [paymentProfileId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([payrollRunId, employeeId])
  @@index([employeeId])
  @@index([salaryAssignmentId])
  @@index([salaryStructureId])
  @@index([paymentProfileId])
  @@map("payroll_run_lines")
}

