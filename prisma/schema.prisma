generator client {
  provider     = "prisma-client"
  output       = "../apps/api/src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum PayrollSourceActionKind {
  APPROVE
  REVOKE
}

enum PayrollReservationState {
  HELD
  RELEASED
  CONSUMED
}

model PayrollFinanceDelegate {
  id String @id @default(cuid())
  companyId String
  userId String
  canInitiate Boolean @default(false)
  canReview Boolean @default(false)
  generation Int
  requestedAt DateTime @default(dbgenerated("(clock_timestamp() AT TIME ZONE 'UTC')"))
  authorizedAt DateTime @default(dbgenerated("(clock_timestamp() AT TIME ZONE 'UTC')"))
  initiatedById String
  reviewedById String
  expiresAt DateTime?
  authorityReference String
  auditSnapshot Json
  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  user User @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  initiatedBy User @relation("PayrollDelegateInitiator", fields: [initiatedById], references: [id], onDelete: Restrict, onUpdate: Restrict)
  reviewedBy User @relation("PayrollDelegateReviewer", fields: [reviewedById], references: [id], onDelete: Restrict, onUpdate: Restrict)
  revocation PayrollFinanceDelegateRevocation?
  @@unique([companyId, userId, generation])
  @@map("payroll_finance_delegates")
}

model PayrollFinanceDelegateRevocation {
  id String @id @default(cuid())
  delegateId String @unique
  requestedAt DateTime @default(dbgenerated("(clock_timestamp() AT TIME ZONE 'UTC')"))
  revokedAt DateTime @default(dbgenerated("(clock_timestamp() AT TIME ZONE 'UTC')"))
  initiatedById String
  reviewedById String
  authorityReference String
  auditSnapshot Json
  delegate PayrollFinanceDelegate @relation(fields: [delegateId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  initiatedBy User @relation("PayrollDelegateRevoker", fields: [initiatedById], references: [id], onDelete: Restrict, onUpdate: Restrict)
  reviewedBy User @relation("PayrollDelegateRevocationReviewer", fields: [reviewedById], references: [id], onDelete: Restrict, onUpdate: Restrict)
  @@map("payroll_finance_delegate_revocations")
}

model PayrollSourceAction {
  id String @id @default(cuid())
  grantId String
  kind PayrollSourceActionKind
  initiatedById String
  createdAt DateTime @default(dbgenerated("(clock_timestamp() AT TIME ZONE 'UTC')"))
  idempotencyKey String @unique @db.VarChar(128)
  auditSnapshot Json
  grant PayrollSourceAuthorization @relation(fields: [grantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  initiatedBy User @relation(fields: [initiatedById], references: [id], onDelete: Restrict, onUpdate: Restrict)
  decision PayrollSourceDecision?
  @@unique([grantId, kind])
  @@map("payroll_source_actions")
}

model PayrollSourceDecision {
  id String @id @default(cuid())
  actionId String @unique
  reviewedById String
  reviewedAt DateTime @default(dbgenerated("(clock_timestamp() AT TIME ZONE 'UTC')"))
  authorityReference String
  auditSnapshot Json
  action PayrollSourceAction @relation(fields: [actionId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  reviewedBy User @relation(fields: [reviewedById], references: [id], onDelete: Restrict, onUpdate: Restrict)
  @@map("payroll_source_decisions")
}

model PayrollPaymentReservation {
  id String @id @default(cuid())
  payrollRunLineId String
  channel PayrollPaymentChannel
  lineId String @unique
  state PayrollReservationState @default(HELD)
  version Int @default(1)
  payrollRunLine PayrollRunLine @relation(fields: [payrollRunLineId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  line PayrollPaymentLine @relation(fields: [lineId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  @@unique([payrollRunLineId, channel])
  @@map("payroll_payment_reservations")
}

model PayrollCancellationRequest {
  id String @id @default(cuid())
  batchId String
  expectedVersion Int
  initiatedById String
  createdAt DateTime @default(dbgenerated("(clock_timestamp() AT TIME ZONE 'UTC')"))
  evidenceReference String
  idempotencyKey String @unique @db.VarChar(128)
  auditSnapshot Json
  batch PayrollPaymentBatch @relation(fields: [batchId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  initiatedBy User @relation(fields: [initiatedById], references: [id], onDelete: Restrict, onUpdate: Restrict)
  decision PayrollCancellationDecision?
  @@map("payroll_cancellation_requests")
}

model PayrollCancellationDecision {
  id String @id @default(cuid())
  requestId String @unique
  reviewedById String
  reviewedAt DateTime @default(dbgenerated("(clock_timestamp() AT TIME ZONE 'UTC')"))
  evidenceDigest String @db.VarChar(64)
  verificationAuthority String
  verifiedAt DateTime
  auditSnapshot Json
  request PayrollCancellationRequest @relation(fields: [requestId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  reviewedBy User @relation(fields: [reviewedById], references: [id], onDelete: Restrict, onUpdate: Restrict)
  @@map("payroll_cancellation_decisions")
}

enum PayrollPaymentChannel {
  BANK
  CASH
}

enum PayrollPaymentBatchStatus {
  PREPARED
  CONFIRMED
  CANCELLED
}

model PayrollSourceAuthorization {
  id String @id @default(cuid())
  companyId String
  sourceAccountId String
  channel PayrollPaymentChannel
  grantedById String
  grantedAt DateTime @default(dbgenerated("(clock_timestamp() AT TIME ZONE 'UTC')"))
  expiresAt DateTime?
  auditSnapshot Json
  generation Int
  sourceRevision String @db.VarChar(64)
  sourceSnapshot Json
  actions PayrollSourceAction[]
  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  sourceAccount CashBankAccount @relation(fields: [sourceAccountId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  grantedBy User @relation("PaymentSourceGrantor", fields: [grantedById], references: [id], onDelete: Restrict, onUpdate: Restrict)
  batches PayrollPaymentBatch[]
  @@unique([companyId, sourceAccountId, channel, generation])
  @@index([grantedById])
  @@map("payroll_source_authorizations")
}

model PayrollPaymentBatch {
  id String @id @default(cuid())
  companyId String
  payrollRunId String
  sourceAccountId String
  sourceAuthorizationId String
  channel PayrollPaymentChannel
  status PayrollPaymentBatchStatus @default(PREPARED)
  version Int @default(1)
  createdById String
  createdAt DateTime @default(dbgenerated("(clock_timestamp() AT TIME ZONE 'UTC')"))
  idempotencyKey String @unique @db.VarChar(128)
  requestHash String @db.VarChar(64)
  totalAmount Decimal @db.Decimal(18,2)
  creationAudit Json
  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  payrollRun PayrollRun @relation(fields: [payrollRunId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  sourceAccount CashBankAccount @relation(fields: [sourceAccountId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  sourceAuthorization PayrollSourceAuthorization @relation(fields: [sourceAuthorizationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  createdBy User @relation(fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Restrict)
  lines PayrollPaymentLine[]
  confirmation PayrollPaymentConfirmation?
  cancellationRequests PayrollCancellationRequest[]
  @@index([payrollRunId, channel])
  @@index([companyId, status])
  @@index([sourceAuthorizationId])
  @@map("payroll_payment_batches")
}

model PayrollPaymentLine {
  cashAcknowledgment PayrollCashAcknowledgment?
  id String @id @default(cuid())
  batchId String
  payrollRunLineId String
  employeeId String
  channel PayrollPaymentChannel
  amount Decimal @db.Decimal(18,2)
  obligationSnapshot Json
  reservation PayrollPaymentReservation?
  batch PayrollPaymentBatch @relation(fields: [batchId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  payrollRunLine PayrollRunLine @relation(fields: [payrollRunLineId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  // Preserve immutable instruction history. Active exclusivity and authorized
  // release/reuse are enforced separately by PayrollPaymentReservation.
  @@unique([batchId, payrollRunLineId, channel])
  @@index([batchId])
  @@index([employeeId])
  @@map("payroll_payment_lines")
}

model PayrollPaymentConfirmation {
  cashAcknowledgments PayrollCashAcknowledgment[]
  id String @id @default(cuid())
  batchId String @unique
  confirmedById String
  confirmedAt DateTime
  evidenceKind String
  evidenceReference String
  evidenceDigest String @db.VarChar(64)
  verificationAuthority String
  verifiedAt DateTime
  attestation Json
  auditSnapshot Json
  idempotencyKey String @unique @db.VarChar(128)
  batch PayrollPaymentBatch @relation(fields: [batchId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  confirmedBy User @relation(fields: [confirmedById], references: [id], onDelete: Restrict, onUpdate: Restrict)
  @@index([confirmedById])
  @@unique([verificationAuthority, evidenceKind, evidenceReference])
  @@map("payroll_payment_confirmations")
}

model PayrollCashAcknowledgment {
  id String @id
  confirmationId String
  lineId String @unique
  authority String
  acknowledgmentId String
  amount Decimal @db.Decimal(18,2)
  occurredAt DateTime @db.Timestamp(3)
  confirmation PayrollPaymentConfirmation @relation(fields: [confirmationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  line PayrollPaymentLine @relation(fields: [lineId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  @@unique([authority, acknowledgmentId])
  @@map("payroll_cash_acknowledgments")
}

model User {
  leaveStageDecisions LeaveStageDecision[] // SPRINT7D
  authorityTickets AuthorityBootstrap[] @relation("BootstrapTarget") // SPRINT7B
  authorizedTickets AuthorityBootstrap[] @relation("BootstrapAuthorizer") // SPRINT7B
  authorityMandates AuthorityMandate[] // SPRINT7B
  authorityGrants AuthorityRoleGrant[] // SPRINT7B
  authorityRequests AuthorityRequest[] @relation("AuthorityInitiator") // SPRINT7B
  authorityReviews AuthorityRequest[] @relation("AuthorityReviewer") // SPRINT7B
  authorityEvents AuthorityEvent[] // SPRINT7B
  adminVersion Int @default(1) // HR4
  hrPermissions UserPermission[] @relation("PermissionSubject") // HR4
  permissionGrants UserPermission[] @relation("PermissionGrantor") // HR4
  permissionRevocations UserPermission[] @relation("PermissionRevoker") // HR4
  employeeBindings EmployeeAccountBinding[] @relation("BindingSubject") // HR4
  bindingVerifications EmployeeAccountBinding[] @relation("BindingVerifier") // HR4
  bindingReleases EmployeeAccountBinding[] @relation("BindingReleaser") // HR4
  adminActions UserAdminEvent[] @relation("AdminActor") // HR4
  adminHistory UserAdminEvent[] @relation("AdminTarget") // HR4
  leaveRequests LeaveRequest[] @relation("LeaveCreator")
  withdrawnLeaveRequests LeaveRequest[] @relation("LeaveWithdrawer")
  reviewedLeaveRequests LeaveRequest[] @relation("LeaveReviewer")
  leaveEvents LeaveRequestEvent[]

  payrollDelegateInitiations PayrollFinanceDelegate[] @relation("PayrollDelegateInitiator")
  payrollDelegateReviews PayrollFinanceDelegate[] @relation("PayrollDelegateReviewer")
  payrollDelegateRevocations PayrollFinanceDelegateRevocation[] @relation("PayrollDelegateRevoker")
  payrollDelegateRevocationReviews PayrollFinanceDelegateRevocation[] @relation("PayrollDelegateRevocationReviewer")
  financeDelegations PayrollFinanceDelegate[]
  sourceActions PayrollSourceAction[]
  sourceDecisions PayrollSourceDecision[]
  cancellationRequests PayrollCancellationRequest[]
  cancellationDecisions PayrollCancellationDecision[]

  payrollSourceGrants PayrollSourceAuthorization[] @relation("PaymentSourceGrantor")
  preparedPaymentBatches PayrollPaymentBatch[]
  payrollPaymentConfirmations PayrollPaymentConfirmation[]

  id                        String                     @id @default(cuid())
  email                     String                     @unique
  fullName                  String
  passwordHash              String
  isActive                  Boolean                    @default(true)
  lastLoginAt               DateTime?
  createdAt                 DateTime                   @default(now())
  updatedAt                 DateTime                   @updatedAt
  roles                     UserRole[]
  sessions                  AuthSession[]
  auditEvents               AuditEvent[]
  createdVouchers           Voucher[]                  @relation("VoucherCreatedBy")
  postedVouchers            Voucher[]                  @relation("VoucherPostedBy")
  createdSalaryStructures   SalaryStructure[]          @relation("SalaryStructureCreatedBy")
  approvedSalaryStructures  SalaryStructure[]          @relation("SalaryStructureApprovedBy")
  createdSalaryAssignments  EmployeeSalaryAssignment[] @relation("SalaryAssignmentCreatedBy")
  approvedSalaryAssignments EmployeeSalaryAssignment[] @relation("SalaryAssignmentApprovedBy")
  createdPaymentProfiles    EmployeePaymentProfile[]   @relation("PaymentProfileCreatedBy")
  approvedPaymentProfiles   EmployeePaymentProfile[]   @relation("PaymentProfileApprovedBy")
  createdPayrollRuns        PayrollRun[]               @relation("PayrollRunCreatedBy")
  approvedPayrollRuns       PayrollRun[]               @relation("PayrollRunApprovedBy")

  createdWorkSchedules       WorkSchedule[]           @relation("WorkScheduleCreatedBy")
  createdScheduleAssignments WorkScheduleAssignment[] @relation("WorkScheduleAssignmentCreatedBy")

  createdAttendanceRevisions    AttendanceRevision[]        @relation("AttendanceRevisionCreatedBy")
  finalizedAttendanceRevisions  AttendanceRevision[]        @relation("AttendanceRevisionFinalizedBy")
  finalizedAttendanceDays       AttendanceDayFinalization[] @relation("AttendanceDayFinalizationFinalizedBy")
  createdAttendancePolicies     AttendancePolicy[]          @relation("AttendancePolicyCreatedBy")
  cancelledAttendancePolicies   AttendancePolicy[]          @relation("AttendancePolicyCancelledBy")
  createdCalendarExceptions     CompanyCalendarException[]  @relation("CalendarExceptionCreatedBy")
  supersededCalendarExceptions  CompanyCalendarException[]  @relation("CalendarExceptionSupersededBy")
  cancelledCalendarExceptions   CompanyCalendarException[]  @relation("CalendarExceptionCancelledBy")

  @@map("users")
  onboardingIdentity OnboardingIdentity? @relation("OnboardingSubject")
  verifiedOnboarding OnboardingIdentity[] @relation("OnboardingVerifier")
  onboardingInvitations OnboardingInvitation[] @relation("InvitationSubject")
  issuedOnboardingInvitations OnboardingInvitation[] @relation("InvitationIssuer")
  onboardingRequests OnboardingAuthorization[] @relation("OnboardingActor")
  onboardingTargets OnboardingAuthorization[] @relation("OnboardingTarget")
  onboardingReviews OnboardingAuthorization[] @relation("OnboardingReviewer")
  onboardingEvents OnboardingEvent[] @relation("OnboardingEventActor")
  onboardingHistory OnboardingEvent[] @relation("OnboardingEventTarget")

}

model Role {
  authorityCompanyId String? // SPRINT7B
  authorityCompany Company? @relation("ManagedRoleCompany", fields: [authorityCompanyId], references: [id], onDelete: Restrict, onUpdate: Restrict) // SPRINT7B
  createdUnderId String? // SPRINT7B
  createdUnder AuthorityMandate? @relation(fields: [createdUnderId], references: [id], onDelete: Restrict, onUpdate: Restrict) // SPRINT7B
  permissionCodes String[] @default([]) // SPRINT7B
  isActive Boolean @default(true) // SPRINT7B
  version Int @default(1) // SPRINT7B
  authorityGrants AuthorityRoleGrant[] // SPRINT7B
  id          String     @id @default(cuid())
  code        String     @unique
  name        String
  description String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  users       UserRole[]

  @@map("roles")
}

model UserRole {
  id        String   @id @default(cuid())
  userId    String
  roleId    String
  createdAt DateTime @default(now())
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@index([roleId])
  @@map("user_roles")
}

model AuthSession {
  id              String    @id @default(cuid())
  userId          String
  activeCompanyId String?
  tokenId         String    @unique
  expiresAt       DateTime
  revokedAt       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  activeCompany   Company?  @relation("AuthSessionActiveCompany", fields: [activeCompanyId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([expiresAt])
  @@index([activeCompanyId])
  @@map("auth_sessions")
}

model AuditEvent {
  id         String   @id @default(cuid())
  userId     String?
  action     String
  entityType String?
  entityId   String?
  ipAddress  String?
  userAgent  String?
  metadata   Json?
  createdAt  DateTime @default(now())
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_events")
}

