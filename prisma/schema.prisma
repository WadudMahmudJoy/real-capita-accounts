generator client {
  provider     = "prisma-client"
  output       = "../apps/api/src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model User {
  id              String        @id @default(cuid())
  email           String        @unique
  fullName        String
  passwordHash    String
  isActive        Boolean       @default(true)
  lastLoginAt     DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  roles           UserRole[]
  sessions        AuthSession[]
  auditEvents     AuditEvent[]
  createdVouchers Voucher[]     @relation("VoucherCreatedBy")
  postedVouchers  Voucher[]     @relation("VoucherPostedBy")

  @@map("users")
}

model Role {
  id          String     @id @default(cuid())
  code        String     @unique
  name        String
  description String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  users       UserRole[]

  @@map("roles")
}

model UserRole {
  id        String   @id @default(cuid())
  userId    String
  roleId    String
  createdAt DateTime @default(now())
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@index([roleId])
  @@map("user_roles")
}

model AuthSession {
  id        String    @id @default(cuid())
  userId    String
  tokenId   String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("auth_sessions")
}

model AuditEvent {
  id         String   @id @default(cuid())
  userId     String?
  action     String
  entityType String?
  entityId   String?
  ipAddress  String?
  userAgent  String?
  metadata   Json?
  createdAt  DateTime @default(now())
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_events")
}

// ---------------------------------------------------------------------------
// Phase 2A: Accounting Foundation
// ---------------------------------------------------------------------------

enum AccountClassCode {
  ASSET
  LIABILITY
  EQUITY
  INCOME
  EXPENSE
}

enum NormalBalanceSide {
  DEBIT
  CREDIT
}

enum AccountingPeriodStatus {
  OPEN
  LOCKED
  CLOSED
}

enum CashBankAccountType {
  CASH
  BANK
}

// ---------------------------------------------------------------------------
// Phase 2C: Voucher Schema Foundation
// ---------------------------------------------------------------------------

enum VoucherType {
  DEBIT
  CREDIT
  JOURNAL
  CONTRA
  PAYMENT
  RECEIPT
}

enum VoucherStatus {
  DRAFT
  POSTED
}

enum VoucherLineSide {
  DEBIT
  CREDIT
}

model Company {
  id                     String                  @id @default(cuid())
  singletonKey           String                  @unique @default("PRIMARY")
  name                   String
  legalName              String?
  address                String?
  phone                  String?
  email                  String?
  currency               String                  @default("BDT")
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  fiscalYears            FiscalYear[]
  vouchers               Voucher[]
  voucherNumberSequences VoucherNumberSequence[]

  @@map("companies")
}

model FiscalYear {
  id                     String                  @id @default(cuid())
  companyId              String
  name                   String
  startDate              DateTime
  endDate                DateTime
  isActive               Boolean                 @default(false)
  isClosed               Boolean                 @default(false)
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  company                Company                 @relation(fields: [companyId], references: [id])
  periods                AccountingPeriod[]
  vouchers               Voucher[]
  voucherNumberSequences VoucherNumberSequence[]

  // A fiscal year should not be both active and closed at the same time.
  // Application logic must maintain this invariant.

  @@map("fiscal_years")
}

model AccountingPeriod {
  id           String                 @id @default(cuid())
  fiscalYearId String
  name         String
  startDate    DateTime
  endDate      DateTime
  status       AccountingPeriodStatus @default(OPEN)
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt
  fiscalYear   FiscalYear             @relation(fields: [fiscalYearId], references: [id])
  vouchers     Voucher[]

  @@map("accounting_periods")
}

model Project {
  id           String        @id @default(cuid())
  code         String        @unique
  name         String
  location     String?
  isActive     Boolean       @default(true)
  notes        String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  costCenters  CostCenter[]
  voucherLines VoucherLine[]

  @@map("projects")
}

model CostCenter {
  id           String        @id @default(cuid())
  projectId    String
  code         String
  name         String
  description  String?
  isActive     Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  project      Project       @relation(fields: [projectId], references: [id])
  voucherLines VoucherLine[]

  @@unique([projectId, code])
  @@map("cost_centers")
}

model AccountClass {
  id            String            @id @default(cuid())
  code          AccountClassCode  @unique
  name          String
  normalBalance NormalBalanceSide
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  groups        AccountGroup[]

  @@map("account_classes")
}

model AccountGroup {
  id             String          @id @default(cuid())
  accountClassId String
  code           String          @unique
  name           String
  description    String?
  isActive       Boolean         @default(true)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  accountClass   AccountClass    @relation(fields: [accountClassId], references: [id])
  ledgerAccounts LedgerAccount[]

  @@map("account_groups")
}

model LedgerAccount {
  id                 String            @id @default(cuid())
  accountGroupId     String
  code               String            @unique
  name               String
  normalBalance      NormalBalanceSide
  requiresProject    Boolean           @default(false)
  requiresCostCenter Boolean           @default(false)
  isCashBank         Boolean           @default(false)
  isActive           Boolean           @default(true)
  description        String?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  accountGroup       AccountGroup      @relation(fields: [accountGroupId], references: [id])
  cashBankAccounts   CashBankAccount[]
  voucherLines       VoucherLine[]

  @@map("ledger_accounts")
}

model CashBankAccount {
  id              String              @id @default(cuid())
  ledgerAccountId String              @unique
  displayName     String
  accountType     CashBankAccountType
  bankName        String?
  branch          String?
  accountNumber   String?
  isActive        Boolean             @default(true)
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  ledgerAccount   LedgerAccount       @relation(fields: [ledgerAccountId], references: [id])
  voucherLines    VoucherLine[]

  @@map("cash_bank_accounts")
}

model Voucher {
  id                 String           @id @default(cuid())
  companyId          String
  fiscalYearId       String
  accountingPeriodId String
  voucherType        VoucherType
  status             VoucherStatus    @default(DRAFT)
  systemVoucherNo    String
  physicalSiNo       String?
  voucherDate        DateTime
  postingDate        DateTime?
  narration          String?
  totalDebit         Decimal          @db.Decimal(18, 2)
  totalCredit        Decimal          @db.Decimal(18, 2)
  createdById        String
  postedById         String?
  isDeleted          Boolean          @default(false)
  deletedAt          DateTime?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  company            Company          @relation(fields: [companyId], references: [id])
  fiscalYear         FiscalYear       @relation(fields: [fiscalYearId], references: [id])
  accountingPeriod   AccountingPeriod @relation(fields: [accountingPeriodId], references: [id])
  createdBy          User             @relation("VoucherCreatedBy", fields: [createdById], references: [id])
  postedBy           User?            @relation("VoucherPostedBy", fields: [postedById], references: [id], onDelete: SetNull)
  lines              VoucherLine[]

  @@unique([companyId, fiscalYearId, systemVoucherNo])
  @@index([companyId])
  @@index([fiscalYearId])
  @@index([accountingPeriodId])
  @@index([voucherDate])
  @@index([status])
  @@index([voucherType])
  @@map("vouchers")
}

model VoucherLine {
  id                String           @id @default(cuid())
  voucherId         String
  lineNo            Int
  side              VoucherLineSide
  ledgerAccountId   String
  projectId         String?
  costCenterId      String?
  cashBankAccountId String?
  description       String?
  amount            Decimal          @db.Decimal(18, 2)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  voucher           Voucher          @relation(fields: [voucherId], references: [id], onDelete: Cascade)
  ledgerAccount     LedgerAccount    @relation(fields: [ledgerAccountId], references: [id])
  project           Project?         @relation(fields: [projectId], references: [id], onDelete: SetNull)
  costCenter        CostCenter?      @relation(fields: [costCenterId], references: [id], onDelete: SetNull)
  cashBankAccount   CashBankAccount? @relation(fields: [cashBankAccountId], references: [id], onDelete: SetNull)

  @@unique([voucherId, lineNo])
  @@index([ledgerAccountId])
  @@index([projectId])
  @@index([costCenterId])
  @@index([cashBankAccountId])
  @@map("voucher_lines")
}

model VoucherNumberSequence {
  id           String      @id @default(cuid())
  companyId    String
  fiscalYearId String
  voucherType  VoucherType
  prefix       String?
  nextNumber   Int         @default(1)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  company      Company     @relation(fields: [companyId], references: [id])
  fiscalYear   FiscalYear  @relation(fields: [fiscalYearId], references: [id])

  @@unique([companyId, fiscalYearId, voucherType])
  @@map("voucher_number_sequences")
}
